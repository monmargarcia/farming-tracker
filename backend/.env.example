# Database (Supabase Postgres — use the direct connection string, port 5432;
# this is a long-running server, not serverless functions, so the pooled 6543
# connection isn't needed here)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Notifications
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=farming@yourdomain.com
RESEND_TO=your@email.com

# Chain RPCs
ALCHEMY_API_KEY=your_alchemy_key
ALCHEMY_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key

# Wallets to track (comma separated)
FARMING_WALLETS=0xf56c...Efb342

# App
PORT=3001
NODE_ENV=development
